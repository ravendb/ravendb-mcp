<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Bundle native libraries (e.g. libzstd) into the single-file exe so an exe-only copy (npm) can load them. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The MCP Skills extension package is marked experimental. -->
    <NoWarn>$(NoWarn);MCPEXP005</NoWarn>
    <AssemblyName>ravendb-mcp</AssemblyName>
    <PackageId>RavenDB.Mcp</PackageId>
    <Version>1.1.0</Version>
    <Authors>RavenDB</Authors>
    <Description>Read-only MCP diagnostics server for RavenDB.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/ravendb/ravendb-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ravendb/ravendb-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © Hibernating Rhinos Ltd.</Copyright>
    <PackageTags>RavenDB;MCP;model-context-protocol;diagnostics;database</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>ravendb-mcp</ToolCommandName>
    <PackageType>McpServer</PackageType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RavenDB.Mcp.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <SkillDir>$(MSBuildThisFileDirectory)../../external/skills/skills/ravendb/</SkillDir>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(SkillDir)**/*.md" LogicalName="skill/ravendb/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="RequireSkillSubmodule" BeforeTargets="BeforeBuild" Condition="!Exists('$(SkillDir)SKILL.md')">
    <Error Text="The ravendb skill is missing at $(SkillDir). Run: git submodule update --init" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="ModelContextProtocol.Extensions.Skills" Version="2.4.0" />
    <PackageReference Include="RavenDB.Client" Version="7.2.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="" />
    <None Include="../../.mcp/server.json" Pack="true" PackagePath=".mcp/" />
  </ItemGroup>

</Project>
